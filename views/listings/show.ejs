<% layout("/layouts/boilerplate") %>

    <link rel="stylesheet" href="/css/rating.css">

    <div class="container mt-4">

        <% if (!listing) { %>
            <div class="alert alert-danger">Listing not found!</div>

            <% } else { %>

                <div class="card shadow-lg" style="width: 28rem; margin: auto;">

                    <% if (listing.image && typeof listing.image === 'object' && listing.image.url) { %>
                        <img src="<%= listing.image.url %>" class="card-img-top">

                        <% } else if (listing.image && typeof listing.image === 'string') { %>
                            <img src="<%= listing.image %>" class="card-img-top">

                            <% } else { %>
                                <img src="https://images.unsplash.com/photo-1472214103451-9374bd1c798e" class="card-img-top">
                                <% } %>

                                    <div class="card-body">

                                        <!-- ✅ FIXED TITLE -->
                                        <h5 class="card-title">
                                            <%= listing.title %>
                                        </h5>

                                        <!-- ✅ SAFE OWNER -->
                                        <p class="card-text">
                                            owned by:
                                            <%= listing.owner && listing.owner.username ? listing.owner.username : "Unknown" %>
                                        </p>

                                        <p class="card-text">
                                            <%= listing.description %>
                                        </p>

                                        <p class="card-text">
                                            <strong>Price:</strong> ₹
                                            <% if (listing.price) { %>
                                                <%= Number(listing.price).toLocaleString("en-IN") %>
                                                    <% } else { %>
                                                        Price not available
                                                        <% } %>
                                        </p>

                                        <p class="card-text">
                                            <strong>Location:</strong>
                                            <%= listing.location %>,
                                                <%= listing.country %>
                                        </p>

                                        <!-- ✅ EDIT/DELETE -->
                                        <% if (currUser && listing.owner && listing.owner._id && listing.owner._id.equals(currUser._id)) { %>
                                            <div class="d-flex justify-content-between">
                                                <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning">Edit</a>

                                                <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                                                    <button class="btn btn-danger">Delete</button>
                                                </form>
                                            </div>
                                            <% } %>

                                                <hr>

                                                <!-- ✅ REVIEWS -->
                                                <h4>All Reviews</h4>

                                                <% if (listing.reviews && listing.reviews.length > 0) { %>

                                                    <% for (let review of listing.reviews) { %>
                                                        <% if (review) { %>

                                                            <div class="card mb-3 p-2">
                                                                <p><strong>Author:</strong>
                                                                    <%= review.author %>
                                                                </p>
                                                                <p><strong>Rating:</strong>
                                                                    <%= review.rating %> Stars</p>
                                                                <p><strong>Comment:</strong>
                                                                    <%= review.comment %>
                                                                </p>

                                                                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                                                    <button class="btn btn-sm btn-dark">Delete</button>
                                                                </form>
                                                            </div>

                                                            <% } %>
                                                                <% } %>

                                                                    <% } else { %>
                                                                        <p>No reviews yet.</p>
                                                                        <% } %>

                                                                            <hr>

                                                                            <!-- ✅ REVIEW FORM -->
                                                                            <% if (currUser) { %>

                                                                                <div class="mt-3">
                                                                                    <h3>Leave a Review</h3>

                                                                                    <form id="review-form" action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">

                                                                                        <input type="hidden" name="review[rating]" id="rating-input">

                                                                                        <h4>Rate this:</h4>

                                                                                        <div class="stars">
                                                                                            <span class="star" data-value="1">★</span>
                                                                                            <span class="star" data-value="2">★</span>
                                                                                            <span class="star" data-value="3">★</span>
                                                                                            <span class="star" data-value="4">★</span>
                                                                                            <span class="star" data-value="5">★</span>
                                                                                        </div>

                                                                                        <p id="rating-value"></p>

                                                                                        <div class="mt-2">
                                                                                            <label class="form-label">Comments:</label>
                                                                                            <textarea name="review[comment]" rows="5" class="form-control" required></textarea>
                                                                                            <div class="invalid-feedback">Please add some comments</div>
                                                                                        </div>

                                                                                        <button class="btn btn-outline-dark mt-3">Submit</button>
                                                                                    </form>
                                                                                </div>

                                                                                <% } %>


                                    </div>

                </div>

                <% } %>


                    <!-- ✅ SCRIPT MOVED OUTSIDE -->
                    <script>
                        const stars = document.querySelectorAll('.star');
                        const ratingText = document.getElementById('rating-value');
                        const ratingInput = document.getElementById('rating-input');

                        stars.forEach(star => {
                            star.addEventListener('click', () => {
                                let value = star.getAttribute('data-value');

                                stars.forEach(s => s.classList.remove('selected'));

                                for (let i = 0; i < value; i++) {
                                    stars[i].classList.add('selected');
                                }

                                ratingInput.value = value;

                                let starOutput = "★".repeat(value) + "☆".repeat(5 - value);
                                ratingText.textContent = "You selected: " + starOutput;
                            });
                        });

                        document.getElementById("review-form").addEventListener("submit", function(e) {
                            if (!ratingInput.value) {
                                e.preventDefault();
                                alert("Please select a rating!");
                            }
                        });
                    </script>